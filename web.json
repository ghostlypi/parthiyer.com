{
  "name": "Parth Iyer",
  "framework": {
    "path": "../coralfw"
  },
  "build": {
    "output": "dist",
    "steps": [
      [
        "python3",
        "publish.py",
        "--generate-only"
      ]
    ],
    "include": [
      "**/*.html",
      "**/*.css",
      "**/*.js",
      "**/*.json",
      "**/*.png",
      "**/*.jpg",
      "**/*.jpeg",
      "**/*.gif",
      "**/*.svg",
      "**/*.webp",
      "**/*.ico",
      "**/*.woff",
      "**/*.woff2",
      "**/*.pdf",
      "**/*.txt",
      "**/*.xml",
      "**/*.webmanifest",
      "CNAME"
    ],
    "exclude": [
      "web.json",
      "framework-manifest.json",
      "README.md",
      "tests/**",
      "legacy/**"
    ]
  },
  "tasks": {}
}
